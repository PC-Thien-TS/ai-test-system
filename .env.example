# Core API
API_BASE_URL=
API_PREFIX=/api/v1
API_TIMEOUT_SEC=30

# Primary auth
API_USER=
API_PASS=

# Optional role-separated auth
API_MERCHANT_USER=
API_MERCHANT_PASS=
API_ADMIN_USER=
API_ADMIN_PASS=

# Stable store/order seeds
API_STORE_ID=
API_STORE_UNIQUE_ID=
API_ORDER_STORE_ID=
API_ORDER_SKU_ID=

# Optional alternate store/sku
API_ALT_STORE_ID=
API_ALT_STORE_UNIQUE_ID=
API_ALT_SKU_ID=

# Merchant ownership hint
API_MERCHANT_STORE_ID=

# Runtime order seed IDs
API_PENDING_ORDER_ID=
API_PAID_ORDER_ID=
API_CANCELLED_ORDER_ID=
API_COMPLETED_ORDER_ID=

# Optional edge-case seeds
API_DISABLED_SKU_ID=
API_OUT_OF_STOCK_SKU_ID=
API_CLOSED_STORE_ID=
API_ORDERING_DISABLED_STORE_ID=

# Optional deterministic seeds
API_NEWS_SLUG=
API_CATEGORY_ADMIN_ID=
API_STORE_CATEGORY_ADMIN_ID=
